# Copy this file to .pipeline/.env.local on the machine that runs the pipeline.
# .env.local is gitignored; keys stay off the repo.
#
# Required:
LINEAR_API_KEY=

# Optional — if set, run-stage.sh posts failure alerts to Slack:
# PIPELINE_SLACK_WEBHOOK_URL=

# ─── GitHub App identity (ENG-13) ─────────────────────────────────────────
# The pipeline authenticates to GitHub as the `twinning-pipeline` App, not
# as a user, so branch protection can legitimately require non-bot approvals.
# Create the App at github.com/settings/apps/new; install on the repo;
# download the private key; then fill these three values.
GH_APP_ID=
GH_APP_INSTALLATION_ID=
GH_APP_PRIVATE_KEY_PATH=~/.twinning-pipeline/github-app.pem
