#!/usr/bin/env bash
# Pre-commit hook: runs the entire bin/*-test.sh suite. Blocks commit on any
# failure outside the KNOWN_BROKEN list.
#
# Install via: bash bin/install-git-hooks.sh   (sets core.hooksPath=.githooks)
# Bypass once: git commit --no-verify          (use sparingly)
#
# Why this exists: ENG-60 shipped a parser that diverged from its writers
# because Phase 3's verification grep was a markdown checkbox, not an
# automated gate. This hook is the gate. See PR #45 for context.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[[ -n "$REPO_ROOT" ]] || { printf 'pre-commit: not inside a git repo\n' >&2; exit 1; }
cd "$REPO_ROOT"

# ─── Test-isolation hardening (2026-05-04 incident) ──────────────────
# Forensic finding: ENG-63/64/65 implementing dispatches halted on
# SEVERE scope violations because test fixtures inside `bin/*-test.sh`
# leaked `seed.txt` (and stray fixture branches) into the live worktree.
# Root mechanisms — defended-against here by stripping the in-bound env
# and operating from a neutral cwd, so test fixtures cannot inadvertently
# resolve a tempdir path back into the harness's actual git repo:
#
#   1) git invokes hooks with `GIT_INDEX_FILE=.git/index` (relative).
#      A test fixture's `cd $tempdir && git ...` resolves the relative
#      path against $tempdir/.git — fine when $tempdir/.git exists, but
#      pathological when a subshell's cd silently fails or when $tempdir
#      isn't yet a git repo at the time GIT_INDEX_FILE is consulted.
#   2) The harness's main repo had `core.bare=true` set (cause unknown,
#      possibly a stray `git init --bare` or a config-merge accident);
#      that flag short-circuits `git init` heuristics in fixtures and
#      makes `git status` on the harness root refuse with
#      "must be run in a work tree", masking the true repo state.
#
# The hook is the correct defense layer because every test invocation
# during a commit goes through it. Belt-and-suspenders test-side hardening
# (unset GIT_* in each test file) tracked separately.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_NAMESPACE \
      GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL \
      GIT_PREFIX GIT_INTERNAL_GETTEXT_TEST_FALLBACKS GIT_CEILING_DIRECTORIES \
      GIT_DISCOVERY_ACROSS_FILESYSTEM

# Invariant: the harness's main repo MUST NOT be bare. Bare-mode flips
# `git status` semantics on the harness root and hides leaked-into-parent
# state. If we detect bare=true, fix it loudly and continue — the hook
# is the right place to self-heal because it runs on every commit.
HARNESS_GIT_DIR="$REPO_ROOT/.git"
if [[ -d "$HARNESS_GIT_DIR" ]]; then
  bare="$(git --git-dir="$HARNESS_GIT_DIR" config --get core.bare 2>/dev/null || printf 'false')"
  if [[ "$bare" == "true" ]]; then
    # ENG-68 D-001: capture forensic snapshot before heal. Source the
    # helper under a guard so a fresh-checkout repo (no bin/ pulled yet)
    # still falls through to the inline heal below.
    if [[ -f "$REPO_ROOT/bin/run-local-helpers.sh" ]]; then
      # The helper depends on $HARNESS_ROOT and (optionally) $PROJECT_STATE_DIR /
      # $HARNESS_STATE_DIR. Provide minimal env so the helper can resolve a
      # forensic dir; we do NOT source common.sh (too many invariants assumed
      # under the hook's set -uo pipefail). Inline the env the helper reads.
      export HARNESS_ROOT="$REPO_ROOT"
      export HARNESS_STATE_DIR="${HARNESS_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/twinning-harness}"
      # PROJECT_STATE_DIR may be empty here; the helper falls back to
      # $HARNESS_STATE_DIR/_unscoped/forensics/.
      # log() is referenced by the helper; provide a stderr-printing stub.
      log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
      # shellcheck disable=SC1091
      if source "$REPO_ROOT/bin/run-local-helpers.sh" 2>/dev/null; then
        capture_core_bare_forensic "$HARNESS_GIT_DIR" \
          || printf '[pre-commit] forensic capture returned non-zero (continuing heal)\n' >&2
      else
        printf '[pre-commit] forensic capture skipped (helper source failed)\n' >&2
      fi
    else
      printf '[pre-commit] forensic capture skipped (run-local-helpers.sh missing)\n' >&2
    fi
    git --git-dir="$HARNESS_GIT_DIR" config core.bare false
    printf '[pre-commit] WARNING: harness main repo had core.bare=true; reset to false. Investigate (likely test-fixture leak via inherited GIT_DIR; forensic dump per ENG-68).\n' >&2
  fi
fi

# ─── Known-broken-on-main tests ──────────────────────────────────────
# Tests in this list are RUN but excluded from the pass/fail gate. Each
# entry MUST be paired with a one-line comment explaining what's broken
# and pointing at follow-up work. When you fix the underlying bug, remove
# the entry — leaving stale skips here is the failure mode this list
# itself is designed to prevent.
KNOWN_BROKEN=(
  # tempdir-cleanup race: rmdir runs on a path the prior step already
  # removed. Reproducible on darwin; needs investigation in the test
  # harness, not the mutex code under test.
  "bin/mutex-test.sh"
  # case-1 "Backend bullet" missing — substantive logic bug in
  # render-pr-body's plan-frontmatter parsing. Pre-dates ENG-60.
  "bin/render-pr-body-test.sh"
  # silent rc=1 with no output — broken setup or an early `set -e` exit.
  # Pre-dates ENG-60.
  "bin/render-prompt-slug-test.sh"
  # C-151: header regex expects `ENG-81-d0007` but _render_event_header
  # (ENG-151) emits only `d0007` (the segment after the last hyphen).
  # Test expectation was written by ENG-154 before ENG-151 finalised the
  # short-tail format.  Pre-existing on origin/main; not an ENG-150
  # regression.  Needs a dedicated fix ticket.
  # C-153: expects `Reason:` / `Trips at:` ENG-153 content not yet
  # implemented.  Same file, same pre-existing status.
  "bin/eng-81-reproducer-test.sh"
)

is_known_broken() {
  local needle="$1" entry
  for entry in "${KNOWN_BROKEN[@]}"; do
    [[ "$entry" == "$needle" ]] && return 0
  done
  return 1
}

# ─── TARGET_REPO setup ───────────────────────────────────────────────
# Tests source bin/common.sh which require_env TARGET_REPO. Most tests
# allocate their own throwaway target, but we provide a default so any
# test that relies on the env var being set inherits a sane value.
HOOK_TMP_TARGET="$(mktemp -d -t pre-commit-hook.XXXXXX)"
trap 'rm -rf "$HOOK_TMP_TARGET"' EXIT
mkdir -p "$HOOK_TMP_TARGET/target/.pipeline-config"
cat > "$HOOK_TMP_TARGET/target/.pipeline-config/config.json" <<'JSON'
{
  "linear": {
    "team_id": "x",
    "project_id": "x",
    "native_states": {"in_review": "x", "done": "x", "active": "x"},
    "workflow_stages": ["brainstorming","planning","implementing","ui","reviewing","qa","building","released"],
    "stage_label_prefix": "stage:"
  },
  "orchestrator": {},
  "human_checkpoints": {"require_human_on_threshold": {}},
  "project": {"slug": "test"}
}
JSON
export TARGET_REPO="$HOOK_TMP_TARGET/target"
export PROJECT_SLUG="${PROJECT_SLUG:-test}"

# ─── Run the suite ───────────────────────────────────────────────────
START=$(date +%s)
total_pass=0 total_fail=0 total_skip=0
gating_failures=()
skipped_list=()

# Strict failure detection: rc != 0, OR a real failed-count pattern in
# stdout. The boundary `[^=0-9]` before the digit prevents matching
# `passed=3 failed=0` (the trailing `0` doesn't match `[1-9]` but the
# preceding `passed=3` would match `3 failed` without the boundary).
detect_failure() {
  local rc="$1" out="$2"
  (( rc != 0 )) && return 0
  grep -qE '❌|^FAIL:|^FAIL |failed=[1-9]|[^=0-9][1-9][0-9]* failed' <<<"$out" \
    && return 0
  return 1
}

printf '\n[pre-commit] running bin/*-test.sh (%s tests)\n' \
  "$(ls bin/*-test.sh 2>/dev/null | wc -l | tr -d ' ')"

for t in bin/*-test.sh; do
  out="$(bash "$t" 2>&1)"
  rc=$?

  if is_known_broken "$t"; then
    total_skip=$((total_skip + 1))
    skipped_list+=("$t")
    if detect_failure "$rc" "$out"; then
      printf '  SKIP %s (known-broken; failed as expected)\n' "$t"
    else
      printf '  SKIP %s (known-broken; PASSED unexpectedly — remove from KNOWN_BROKEN)\n' "$t"
    fi
    continue
  fi

  if detect_failure "$rc" "$out"; then
    total_fail=$((total_fail + 1))
    gating_failures+=("$t")
    printf '  FAIL %s (rc=%s)\n' "$t" "$rc"
  else
    total_pass=$((total_pass + 1))
    printf '  PASS %s\n' "$t"
  fi
done

ELAPSED=$(( $(date +%s) - START ))

# ─── Summary + gate decision ─────────────────────────────────────────
printf '\n[pre-commit] %s passed, %s failed, %s skipped (known-broken) in %ss\n' \
  "$total_pass" "$total_fail" "$total_skip" "$ELAPSED"

if (( total_fail > 0 )); then
  printf '\n[pre-commit] BLOCKED — gating failures:\n'
  for t in "${gating_failures[@]}"; do
    printf '  - %s\n' "$t"
  done
  printf '\nRe-run a single failing test with:\n'
  printf '  bash %s\n' "${gating_failures[0]}"
  printf '\nBypass once (use sparingly — the hook exists because ENG-60'\''s\n'
  printf 'verification was a markdown checkbox and look how that went):\n'
  printf '  git commit --no-verify\n\n'
  exit 1
fi

# Surface known-broken status loudly so the list does not silently rot.
if (( total_skip > 0 )); then
  printf '\n[pre-commit] reminder: %s test(s) on KNOWN_BROKEN list\n' "$total_skip"
  for t in "${skipped_list[@]}"; do
    printf '  - %s\n' "$t"
  done
  printf '  (fix and remove from .githooks/pre-commit when you can)\n'
fi

exit 0
