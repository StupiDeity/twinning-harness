        { "kind": "grep", "path": "bin/agent-prompts-content-test.sh", "pattern": "ENG-133", "expect_match": true },
        { "kind": "grep", "path": "bin/agent-prompts-content-test.sh", "pattern": "Findings: \\(critical=", "expect_match": true },
        { "kind": "grep", "path": "bin/agent-prompts-content-test.sh", "pattern": "mechanical: critical == 0 AND major == 0", "expect_match": true },
