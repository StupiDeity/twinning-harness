        },
        {
          "kind": "grep",
          "path": "bin/common.sh",
          "pattern": "48\\) printf 'review-ledger-malformed' ;;",
          "expect_match": true
        },
        {
          "kind": "grep",
          "path": "bin/common.sh",
          "pattern": "49\\) printf 'review-ledger-incomplete' ;;",
          "expect_match": true
