        {
          "kind": "smoke",
          "command": "bash bin/review-ledger-schema-adversarial-test.sh",
          "expect_exit": 0,
          "expect_stdout_match": null
        },
        {
          "kind": "smoke",
          "command": "bash bin/agent-prompts-content-test.sh",
