{
  "plan_schema_version": 1,
  "issue_id": "ENG-119",
  "features": [
    {
      "id": "F-1",
      "summary": "Review-stage emits structurally validated $issue_dir/verdict-review.json on every dispatch; orchestrator halts the dispatch with review-payload-invalid when the payload is missing, malformed, or incomplete.",
      "pass_criteria": [
        { "kind": "file_exists", "path": "bin/review-payload-schema.sh" },
        { "kind": "file_exists", "path": "bin/review-payload-schema-test.sh" },
        { "kind": "smoke", "command": "bash bin/review-payload-schema-test.sh", "expect_exit": 0, "expect_stdout_match": null },
        { "kind": "grep", "path": "bin/common.sh", "pattern": "review-payload-malformed", "expect_match": true },
        { "kind": "grep", "path": "bin/common.sh", "pattern": "review-payload-incomplete", "expect_match": true },
        { "kind": "grep", "path": "bin/common.sh", "pattern": "review-payload-missing", "expect_match": true },
        { "kind": "grep", "path": "bin/pipeline-events.json", "pattern": "review-payload-invalid", "expect_match": true },
        { "kind": "grep", "path": "bin/render-prompt.sh", "pattern": "verdict_review_path=_resolve_verdict_review_path", "expect_match": true },
        { "kind": "grep", "path": "bin/render-prompt.sh", "pattern": "_resolve_verdict_review_path\\(\\)", "expect_match": true },
        { "kind": "grep", "path": "bin/render-prompt.sh", "pattern": "_RENDER_VERDICT_REVIEW_PATH", "expect_match": true },
        { "kind": "grep", "path": "bin/run-stage.sh", "pattern": "_validate_review_payload\\(\\)", "expect_match": true },
        { "kind": "grep", "path": "bin/run-stage.sh", "pattern": "_post_review_payload_halt\\(\\)", "expect_match": true },
        { "kind": "grep", "path": "bin/run-stage.sh", "pattern": "verdict-review\\.json", "expect_match": true },
        { "kind": "grep", "path": "AGENT_PROMPTS.md", "pattern": "verdict_review_path", "expect_match": true },
        { "kind": "grep", "path": "AGENT_PROMPTS.md", "pattern": "Dimension scoring payload", "expect_match": true },
        { "kind": "grep", "path": "docs/runbooks/recovery.md", "pattern": "review-payload-invalid", "expect_match": true },
        { "kind": "grep", "path": "learned-rules/harness/project-profile.md", "pattern": "review-payload-schema-test\\.sh", "expect_match": true },
        { "kind": "smoke", "command": "bash bin/render-prompt-test.sh", "expect_exit": 0, "expect_stdout_match": null },
        { "kind": "smoke", "command": "bash bin/run-stage-test.sh", "expect_exit": 0, "expect_stdout_match": null },
        { "kind": "smoke", "command": "bash bin/common-test.sh", "expect_exit": 0, "expect_stdout_match": null }
      ]
    }
  ]
}
